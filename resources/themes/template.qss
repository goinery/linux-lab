/* ==========================================================================
 * 统一主题样式模板
 * --------------------------------------------------------------------------
 * 占位符语法：@token@ ，由 ThemeManager::render() 在运行时按 ThemePalette
 *   逐个 token 进行字符串替换得到最终 QSS。
 *
 * 修改"结构 / 选择器 / 布局" → 仅编辑本文件。
 * 修改"主题颜色 / 字体"      → 仅编辑 src/theme_manager.cpp 中对应 palette。
 * ========================================================================== */

* {
    font-family: @fontFamily@;
}

QWidget {
    font-size: 14px;
    color: @textBody@;
}

QMainWindow, #rootWidget {
    background: @bgWindow@;
}

/* ---- Title Bar ---- */
#titleBar {
    background: @bgTitleBar@;
    border-bottom: 1px solid @borderLine@;
}
#titleBarIcon {
    font-size: 16px;
    color: @primary@;
    background: @bgTitleBarIcon@;
    border-radius: 13px;
}
#titleBarLabel {
    font-size: 13px;
    font-weight: 700;
    color: @textTitle@;
}
#winMinBtn, #winMaxBtn, #winCloseBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    font-size: 15px;
    padding: 0px;
    color: @textWinBtn@;
}
#winMinBtn:hover, #winMaxBtn:hover {
    background: @bgWinBtnHover@;
}
#winCloseBtn:hover {
    background: @bgWinCloseHover@;
    color: #ffffff;
}

#bodyWrap {
    background: transparent;
}

/* ---- Side Bar ---- */
#sideBar {
    background: @bgSideBar@;
    border: none;
}
#sideLogo {
    font-size: 13px;
    font-weight: 800;
    background: @primary@;
    color: @onPrimary@;
    border-radius: 21px;
}
#sideBarBtn {
    background: transparent;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    color: @textSideBtn@;
    padding: 4px;
}
QPushButton#sideBarBtn::menu-indicator {
    image: none;
    width: 0px;
}
#sideBarBtn:hover {
    background: @bgSideBtnHover@;
}
#sideBarBtn:pressed {
    background: @bgSideBtnPressed@;
}

#mainArea {
    background: transparent;
}

/* ---- Top Bar ---- */
#topBar {
    background: @bgTopBar@;
    border-radius: 16px;
    border: 1px solid @borderPanel@;
}
#topBarTitle {
    font-size: 17px;
    font-weight: 800;
    color: @textTitle@;
}
#topBarSubtitle {
    font-size: 13px;
    color: @textSubtitle@;
    font-weight: 500;
}
#topBarBadge {
    font-size: 11px;
    color: @primary@;
    background: @bgTopBarBadge@;
    border-radius: 10px;
    padding: 3px 10px;
    font-weight: 600;
}

/* ---- Menus ---- */
QMenuBar {
    background: @bgMenuBar@;
    border-radius: 12px;
    padding: 5px 10px;
    color: @textMenuBar@;
    border: 1px solid @borderPanel@;
}
QMenuBar::item:selected {
    background: @bgMenuBarItemHover@;
    border-radius: 10px;
}

QMenu {
    background: @bgMenu@;
    border: 1px solid @borderInput@;
    border-radius: 12px;
    padding: 6px;
}
QMenu::item {
    padding: 8px 32px 8px 16px;
    border-radius: 8px;
    color: @textMenuItem@;
}
QMenu::item:selected {
    background: @bgMenuItemHover@;
}

/* ---- Buttons ---- */
QPushButton {
    border: 1px solid @borderInput@;
    border-radius: 12px;
    padding: 9px 18px;
    background: @bgButton@;
    color: @textButton@;
    font-weight: 500;
}
QPushButton#primaryButton, QPushButton#sendButton {
    background: @primary@;
    color: @onPrimary@;
    border: none;
    font-weight: 600;
    letter-spacing: 0.3px;
}
QPushButton#primaryButton:hover, QPushButton#sendButton:hover {
    background: @primaryHover@;
}
QPushButton:hover {
    background: @bgButtonHover@;
}

/* ---- Cards / Pages ---- */
QFrame#card {
    background: @bgCard@;
    border: 1px solid @borderCard@;
    border-radius: 20px;
}

#pageScroll {
    background: @bgPageScroll@;
    border: none;
}
QScrollArea#pageScroll > QWidget#qt_scrollarea_viewport {
    background: @bgPageScroll@;
}
#pages {
    background: @bgPageScroll@;
}

#cardTitle {
    font-size: 20px;
    font-weight: 700;
    color: @textTitle@;
    padding-bottom: 2px;
}

QLabel {
    color: @textLabel@;
}

/* ---- Inputs ---- */
QLineEdit, QTextEdit#inputEdit {
    background: @bgInput@;
    border: 1px solid @borderInput@;
    border-radius: 12px;
    padding: 10px 12px;
    color: @textInput@;
}
QLineEdit:focus, QTextEdit#inputEdit:focus {
    border: 1.5px solid @primary@;
}
QTextEdit#inputEdit::placeholder {
    color: @textInputPlaceholder@;
}

/* ---- Lists ---- */
QListWidget {
    background: @bgInput@;
    border: 1px solid @borderInput@;
    border-radius: 12px;
    padding: 4px;
}
QListWidget::item {
    border-radius: 10px;
    padding: 8px 12px;
    margin: 1px 2px;
    color: @textListItem@;
}
QListWidget::item:selected {
    background: @primary@;
    color: @onPrimary@;
}

/* ---- Status Label ---- */
#statusLabel {
    color: @textStatusLabel@;
    min-height: 24px;
    font-weight: 600;
    font-size: 13px;
}

/* ---- Left Panel (用户列表) ---- */
#leftPanel {
    background: @bgPanelLeft@;
    border-radius: 16px;
    border: 1px solid @borderPanel@;
}

#userListTitle {
    color: @textTitle@;
    background: transparent;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 2px;
    border: none;
}
QListWidget#userList {
    background: transparent;
    border: 1px solid @borderInput@;
    border-radius: 12px;
    outline: none;
}
QListWidget#userList::item {
    color: @textListItem@;
    border-radius: 10px;
    border: 1px solid transparent;
    padding: 10px;
    margin: 2px 6px;
}
QListWidget#userList::item:hover {
    background: @bgUserListItemHover@;
}
QListWidget#userList::item:selected {
    background: @primary@;
    border: 1px solid @primaryDark@;
    color: @onPrimary@;
}

/* ---- Right Panel / Chat ---- */
#rightPanel {
    background: @bgPanelRight@;
    border-radius: 16px;
}

#chatTitleLabel {
    color: @textTitle@;
    background: transparent;
    border: none;
    font-weight: 600;
    font-size: 15px;
}
#chatScrollArea, #messagesContainer {
    background: @bgChatArea@;
    border: 1px solid @borderPanel@;
    border-radius: 14px;
}

#inputArea {
    background: transparent;
    border: none;
}

/* ---- Bubbles ---- */
#avatarSelf {
    background: @primary@;
    color: @onPrimary@;
    border-radius: 20px;
    border: 2px solid @borderAvatarSelf@;
}
#avatarOther {
    background: @avatarOtherBg@;
    color: @avatarOtherFg@;
    border-radius: 20px;
    border: 2px solid @borderAvatarOther@;
}

#bubbleSelf {
    background: @primary@;
    color: @onPrimary@;
    border-radius: 16px;
    border: none;
    padding: 6px 10px;
}
#bubbleOther {
    background: @bgBubbleOther@;
    color: @textBubbleOther@;
    border-radius: 16px;
    border: 1px solid @borderBubbleOther@;
    padding: 6px 10px;
}

#nameSelf {
    color: @textNameSelf@;
    font-size: 12px;
}
#nameOther {
    color: @textNameOther@;
    font-size: 12px;
}
#timeLabel {
    color: @textTimeLabel@;
    font-size: 12px;
}
#systemMessage {
    color: @textSystemMessage@;
    font-size: 12px;
    background: transparent;
    padding: 4px 0;
}

/* ---- Status Bar ---- */
QStatusBar {
    background: @bgStatusBar@;
    color: @textStatusBar@;
    border-top: 1px solid @borderLine@;
    font-size: 12px;
}

QToolTip {
    background: @bgTooltip@;
    color: @textTooltip@;
    border: 1px solid @borderInput@;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
}

/* ---- Scroll Bars ---- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: @scrollHandle@;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: @scrollHandleHover@;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: @scrollHandle@;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: @scrollHandleHover@;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ---- Radio Buttons ---- */
QRadioButton {
    spacing: 8px;
    padding: 4px 0;
    color: @textLabel@;
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 11px;
    border: 2px solid @borderRadio@;
    background: @bgInput@;
}
QRadioButton::indicator:checked {
    background: @primary@;
    border: 2px solid @primaryDark@;
}

/* ---- Splitter ---- */
QSplitter::handle {
    background: @splitterBg@;
    width: 1px;
}
QSplitter::handle:hover {
    background: @primary@;
}
