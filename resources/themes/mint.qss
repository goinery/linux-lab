* {
    font-family: "LXGW WenKai", "Huawei Sans", "Noto Sans CJK SC", "Noto Sans SC", "WenQuanYi Micro Hei", "WenQuanYi Zen Hei", "Source Han Sans CN", "Microsoft YaHei", "Segoe UI", "PingFang SC", sans-serif;
}

QWidget {
    font-size: 14px;
    color: #2d3748;
}

QMainWindow, #rootWidget {
    background: #e8efe6;
}

#titleBar {
    background: #d4e2d0;
    border-bottom: 1px solid #c4d6c0;
}
#titleBarIcon {
    font-size: 16px;
    color: #5c9b6f;
    background: #f0f7ef;
    border-radius: 13px;
}
#titleBarLabel {
    font-size: 13px;
    font-weight: 700;
    color: #2d4a34;
}
#winMinBtn, #winMaxBtn, #winCloseBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    font-size: 15px;
    padding: 0px;
    color: #4a6e52;
}
#winMinBtn:hover, #winMaxBtn:hover {
    background: #c4d6c0;
}
#winCloseBtn:hover {
    background: #e07070;
    color: #ffffff;
}

#bodyWrap {
    background: transparent;
}

#sideBar {
    background: #d8e5d4;
    border: none;
}
#sideLogo {
    font-size: 13px;
    font-weight: 800;
    background: #5c9b6f;
    color: #ffffff;
    border-radius: 21px;
}
#sideBarBtn {
    background: transparent;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    color: #3b5a3e;
}
#sideBarBtn:hover {
    background: #c4d8c0;
}
#sideBarBtn:pressed {
    background: #aec8aa;
}

#mainArea {
    background: transparent;
}

#topBar {
    background: #f6faf3;
    border-radius: 16px;
    border: 1px solid #d4e4d4;
}
#topBarTitle {
    font-size: 17px;
    font-weight: 800;
    color: #2d4a34;
}
#topBarSubtitle {
    font-size: 13px;
    color: #6b876f;
    font-weight: 500;
}
#topBarBadge {
    font-size: 11px;
    color: #5c9b6f;
    background: #e0f0e0;
    border-radius: 10px;
    padding: 3px 10px;
    font-weight: 600;
}

QMenuBar {
    background: #f8faf6;
    border-radius: 12px;
    padding: 5px 10px;
    color: #2d4a34;
    border: 1px solid #d8e6d8;
}
QMenuBar::item:selected {
    background: #d5ebd5;
    border-radius: 10px;
}

QMenu {
    background: #ffffff;
    border: 1px solid #c8dec8;
    border-radius: 12px;
    padding: 6px;
}
QMenu::item {
    padding: 8px 32px 8px 16px;
    border-radius: 8px;
}
QMenu::item:selected {
    background: #e6f4e6;
}

QPushButton {
    border: 1px solid #bccfbc;
    border-radius: 12px;
    padding: 9px 18px;
    background: #f6faf4;
    color: #2d4a34;
    font-weight: 500;
}
QPushButton#primaryButton, QPushButton#sendButton {
    background: #5c9b6f;
    color: #ffffff;
    border: none;
    font-weight: 600;
    letter-spacing: 0.3px;
}
QPushButton#primaryButton:hover, QPushButton#sendButton:hover {
    background: #4d8b60;
}
QPushButton:hover {
    background: #e2f0e2;
}

QFrame#card {
    background: #fafef9;
    border: 1px solid #d9e8d9;
    border-radius: 20px;
}

#pageScroll {
    background: transparent;
    border: none;
}

#cardTitle {
    font-size: 20px;
    font-weight: 700;
    color: #1a3522;
    padding-bottom: 2px;
}

QLabel {
    color: #2d4434;
}

QLineEdit, QTextEdit#inputEdit {
    background: #ffffff;
    border: 1px solid #c8dcc8;
    border-radius: 12px;
    padding: 10px 12px;
    color: #243a2a;
}
QLineEdit:focus, QTextEdit#inputEdit:focus {
    border: 1.5px solid #5c9b6f;
}

QListWidget {
    background: #ffffff;
    border: 1px solid #c8dcc8;
    border-radius: 12px;
    padding: 4px;
}
QListWidget::item {
    border-radius: 10px;
    padding: 8px 12px;
    margin: 1px 2px;
    color: #2d4434;
}
QListWidget::item:selected {
    background: #5c9b6f;
    color: #ffffff;
}

#statusLabel {
    color: #c0392b;
    min-height: 24px;
    font-weight: 600;
    font-size: 13px;
}

#leftPanel {
    background: #eaf3ea;
    border-radius: 16px;
    border: 1px solid #d4e4d4;
}

#userListTitle {
    color: #2d4434;
    background: transparent;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 2px;
}
QListWidget#userList {
    background: transparent;
    border: 1px solid #c5dcc5;
    border-radius: 12px;
    outline: none;
}
QListWidget#userList::item {
    color: #2d4434;
    border-radius: 10px;
    border: 1px solid transparent;
    padding: 10px;
    margin: 2px 6px;
}
QListWidget#userList::item:hover {
    background: #deefde;
}
QListWidget#userList::item:selected {
    background: #5c9b6f;
    border: 1px solid #4a8760;
    color: #ffffff;
}

#rightPanel {
    background: #f6faf4;
    border-radius: 16px;
}

#chatTitleLabel {
    color: #1f3828;
    background: transparent;
    border: none;
    font-weight: 600;
    font-size: 15px;
}
#chatScrollArea, #messagesContainer {
    background: #f9fdf6;
    border: 1px solid #d6e6d6;
    border-radius: 14px;
}

#inputArea {
    background: transparent;
    border: none;
}

#avatarSelf {
    background: #5c9b6f;
    color: #ffffff;
    border-radius: 20px;
    border: 2px solid #88c498;
}
#avatarOther {
    background: #7a9db8;
    color: #ffffff;
    border-radius: 20px;
    border: 2px solid #a3bed4;
}

#bubbleSelf {
    background: #5c9b6f;
    color: #ffffff;
    border-radius: 16px;
    border: none;
}
#bubbleOther {
    background: #eaf5e8;
    color: #243a2a;
    border-radius: 16px;
    border: 1px solid #c6dcc6;
}

#nameSelf, #nameOther, #timeLabel {
    color: #667a68;
    font-size: 12px;
}
#systemMessage {
    color: #667a68;
    font-size: 12px;
    background: transparent;
    padding: 4px 0;
}

QStatusBar {
    background: #f0f6ef;
    color: #39503a;
    border-top: 1px solid #dce8dc;
    font-size: 12px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #b8ccb8;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #9cb89c;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QRadioButton {
    spacing: 8px;
    padding: 4px 0;
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 11px;
    border: 2px solid #bccfbc;
}
QRadioButton::indicator:checked {
    background: #5c9b6f;
    border: 2px solid #4d8b60;
}

QSplitter::handle {
    background: #d0e0d0;
    width: 1px;
}
