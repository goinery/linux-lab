* {
    font-family: "LXGW WenKai", "Huawei Sans", "Noto Sans CJK SC", "Noto Sans SC", "WenQuanYi Micro Hei", "WenQuanYi Zen Hei", "Source Han Sans CN", "Microsoft YaHei", "Segoe UI", "PingFang SC", sans-serif;
}

QWidget {
    font-size: 14px;
    color: #c8d6e5;
}

QMainWindow, #rootWidget {
    background: #0a1019;
}

#titleBar {
    background: #111b2e;
    border-bottom: 1px solid #1f3148;
}
#titleBarIcon {
    font-size: 16px;
    color: #2d9eb6;
    background: #1a2a42;
    border-radius: 13px;
}
#titleBarLabel {
    font-size: 13px;
    font-weight: 700;
    color: #dce8f8;
}
#winMinBtn, #winMaxBtn, #winCloseBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    font-size: 15px;
    padding: 0px;
    color: #6c84a2;
}
#winMinBtn:hover, #winMaxBtn:hover {
    background: #1f3148;
}
#winCloseBtn:hover {
    background: #c04444;
    color: #ffffff;
}

#bodyWrap {
    background: transparent;
}

#sideBar {
    background: #10192a;
    border: none;
}
#sideLogo {
    font-size: 13px;
    font-weight: 800;
    background: #2d9eb6;
    color: #f4fbff;
    border-radius: 21px;
}
#sideBarBtn {
    background: transparent;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    color: #7a96b8;
}
#sideBarBtn:hover {
    background: #1a2a42;
}
#sideBarBtn:pressed {
    background: #243652;
}

#mainArea {
    background: transparent;
}

#topBar {
    background: #131f34;
    border-radius: 16px;
    border: 1px solid #243858;
}
#topBarTitle {
    font-size: 17px;
    font-weight: 800;
    color: #dce8f8;
}
#topBarSubtitle {
    font-size: 13px;
    color: #6e86a8;
    font-weight: 500;
}
#topBarBadge {
    font-size: 11px;
    color: #2d9eb6;
    background: #1a3048;
    border-radius: 10px;
    padding: 3px 10px;
    font-weight: 600;
}

QMenuBar {
    background: #141f32;
    border-radius: 12px;
    padding: 5px 10px;
    color: #ccdef8;
    border: 1px solid #243856;
}
QMenuBar::item:selected {
    background: #233652;
    border-radius: 10px;
}

QMenu {
    background: #182438;
    border: 1px solid #284568;
    border-radius: 12px;
    padding: 6px;
}
QMenu::item {
    padding: 8px 32px 8px 16px;
    border-radius: 8px;
    color: #d0e0f5;
}
QMenu::item:selected {
    background: #253a56;
}

QPushButton {
    border: 1px solid #2a4565;
    border-radius: 12px;
    padding: 9px 18px;
    background: #162438;
    color: #c8daf2;
    font-weight: 500;
}
QPushButton#primaryButton, QPushButton#sendButton {
    background: #2d9eb6;
    color: #f0f9ff;
    border: none;
    font-weight: 600;
    letter-spacing: 0.3px;
}
QPushButton#primaryButton:hover, QPushButton#sendButton:hover {
    background: #268ea5;
}
QPushButton:hover {
    background: #1f3048;
}

QFrame#card {
    background: #132138;
    border: 1px solid #274668;
    border-radius: 20px;
}

#pageScroll {
    background: #0a1019;
    border: none;
}
QScrollArea#pageScroll > QWidget#qt_scrollarea_viewport {
    background: #0a1019;
}
#pages {
    background: #0a1019;
}

#cardTitle {
    font-size: 20px;
    font-weight: 700;
    color: #eaf3ff;
    padding-bottom: 2px;
}

QLabel {
    color: #c4d6eb;
}

QLineEdit, QTextEdit#inputEdit {
    background: #0e1826;
    border: 1px solid #294868;
    border-radius: 12px;
    padding: 10px 12px;
    color: #d4e4f6;
}
QLineEdit:focus, QTextEdit#inputEdit:focus {
    border: 1.5px solid #2d9eb6;
}

QListWidget {
    background: #0e1826;
    border: 1px solid #294868;
    border-radius: 12px;
    padding: 4px;
}
QListWidget::item {
    border-radius: 10px;
    padding: 8px 12px;
    margin: 1px 2px;
    color: #c4d6eb;
}
QListWidget::item:selected {
    background: #2d9eb6;
    color: #f4fbff;
}

#statusLabel {
    color: #ff8b94;
    min-height: 24px;
    font-weight: 700;
    font-size: 13px;
}

#leftPanel {
    background: #101e32;
    border-radius: 16px;
    border: 1px solid #243858;
}

#userListTitle {
    color: #ccdef8;
    background: transparent;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 2px;
    border: none;
}
QListWidget#userList {
    background: transparent;
    border: 1px solid #294868;
    border-radius: 12px;
    outline: none;
}
QListWidget#userList::item {
    color: #c4d6eb;
    border-radius: 10px;
    border: 1px solid transparent;
    padding: 10px;
    margin: 2px 6px;
}
QListWidget#userList::item:hover {
    background: #243856;
}
QListWidget#userList::item:selected {
    background: #2d9eb6;
    border: 1px solid #4dbccf;
    color: #f4fbff;
}

#rightPanel {
    background: #0f1929;
    border-radius: 16px;
}

#chatTitleLabel {
    color: #deecff;
    background: transparent;
    border: none;
    font-weight: 600;
    font-size: 15px;
}
#chatScrollArea, #messagesContainer {
    background: #101c2e;
    border: 1px solid #274668;
    border-radius: 14px;
}

#inputArea {
    background: transparent;
    border: none;
}

#avatarSelf {
    background: #2d9eb6;
    color: #f4fbff;
    border-radius: 20px;
    border: 2px solid #55c0d0;
}
#avatarOther {
    background: #3a5075;
    color: #dce8f5;
    border-radius: 20px;
    border: 2px solid #5c749c;
}

#bubbleSelf {
    background: #2d9eb6;
    color: #f4fbff;
    border-radius: 16px;
    font-weight: 500;
    padding: 10px 15px;
}
#bubbleOther {
    background: #192c44;
    color: #d2e2f5;
    border-radius: 16px;
    border: 1px solid #335378;
    padding: 10px 15px;
}

#nameSelf {
    color: #64c8d8;
    font-size: 12px;
}
#nameOther {
    color: #8eb8f0;
    font-size: 12px;
}
#timeLabel {
    color: #788ba8;
    font-size: 12px;
}
#systemMessage {
    color: #788ba8;
    font-size: 12px;
    background: transparent;
    padding: 4px 0;
}

QStatusBar {
    background: #0f192a;
    color: #bccadf;
    border-top: 1px solid #243854;
    font-size: 12px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #2a4462;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #345478;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QRadioButton {
    spacing: 8px;
    padding: 4px 0;
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 11px;
    border: 2px solid #2f4a6a;
}
QRadioButton::indicator:checked {
    background: #2d9eb6;
    border: 2px solid #268ca3;
}

QSplitter::handle {
    background: #243654;
    width: 1px;
}

QTextEdit#inputEdit::placeholder {
    color: #6a80a0;
}
