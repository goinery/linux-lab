* {
    font-family: "Huawei Sans", "Noto Sans CJK SC", "Noto Sans SC", "WenQuanYi Micro Hei", "WenQuanYi Zen Hei", "Source Han Sans CN", "Microsoft YaHei", "Segoe UI", "PingFang SC", sans-serif;
}

QWidget {
    font-size: 14px;
}

QMainWindow {
    background-color: #f2f3f5;
}

/* ---- Title Bar ---- */
#titleBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e2e5;
}

#titleBarLabel {
    color: #333333;
    font-size: 15px;
    font-weight: bold;
}

#titleBarSubLabel {
    color: #888888;
    font-size: 12px;
}

#topBarBtn {
    color: #666666;
    border: none;
    background: transparent;
    font-size: 14px;
    font-weight: bold;
    border-radius: 6px;
    padding: 4px 8px;
}

#topBarBtn:hover {
    background-color: #e8eaed;
    color: #333333;
}

/* ---- Side Bar ---- */
#sideBar {
    background-color: #ffffff;
    border-right: 1px solid #e0e2e5;
}

#sideLogo {
    background-color: #5c6bc0;
    color: #ffffff;
    font-size: 16px;
    font-weight: 900;
    border-radius: 12px;
}

#sideBarBtn {
    color: #888888;
    border: none;
    background: transparent;
    font-size: 16px;
    border-radius: 8px;
    padding: 4px;
}

#sideBarBtn:hover {
    background-color: #eef0f5;
    color: #333333;
}

#zoomLevelSideLabel {
    color: #999999;
    font-size: 12px;
}

#disconnectSideBtn {
    color: #d9534f;
    border: none;
    background: transparent;
    font-size: 14px;
    border-radius: 8px;
    padding: 6px;
}

#disconnectSideBtn:hover {
    background-color: #fce4e4;
    color: #c9302c;
}

/* ---- Left Panel ---- */
#leftPanel {
    background-color: #fafbfc;
    border-right: 1px solid #e8eaed;
}

#userListTitle {
    color: #444444;
    font-size: 15px;
    font-weight: bold;
    background-color: #fafbfc;
    border-bottom: 1px solid #e8eaed;
    padding: 12px;
    letter-spacing: 2px;
}

QListWidget#userList {
    background-color: #fafbfc;
    border: none;
    outline: none;
    padding: 6px;
}

QListWidget#userList::item {
    padding: 12px 14px;
    border-radius: 10px;
    margin: 3px 4px;
    color: #666666;
    font-size: 14px;
}

QListWidget#userList::item:hover {
    background-color: #eef0f5;
    color: #333333;
}

QListWidget#userList::item:selected {
    background-color: #5c6bc0;
    color: #ffffff;
    font-weight: bold;
}

/* ---- Right Panel ---- */
#rightPanel {
    background-color: #f2f3f5;
}

#chatTitleLabel {
    color: #333333;
    font-size: 16px;
    font-weight: bold;
    background-color: #ffffff;
    border-bottom: 1px solid #e8eaed;
    padding: 12px 20px;
}

#chatScrollArea {
    background-color: #f2f3f5;
    border: none;
}

#messagesContainer {
    background-color: #f2f3f5;
}

/* ---- Input Area ---- */
#inputArea {
    background-color: #ffffff;
    border-top: 1px solid #e8eaed;
}

QTextEdit#inputEdit {
    background-color: #f2f3f5;
    border: 2px solid #e0e2e5;
    border-radius: 16px;
    padding: 10px 18px;
    font-size: 14px;
    color: #333333;
    selection-background-color: #5c6bc0;
    selection-color: #ffffff;
}

QTextEdit#inputEdit:focus {
    border-color: #5c6bc0;
    background-color: #ffffff;
}

QPushButton#sendButton {
    background-color: #5c6bc0;
    color: #ffffff;
    border: none;
    border-radius: 14px;
    font-size: 15px;
    font-weight: bold;
    padding: 10px 20px;
    letter-spacing: 2px;
}

QPushButton#sendButton:hover {
    background-color: #4a5ab0;
}

QPushButton#sendButton:pressed {
    background-color: #3a4aa0;
}

/* ---- Bubbles ---- */
#avatarSelf {
    background-color: #5c6bc0;
    color: #ffffff;
    border-radius: 20px;
}

#avatarOther {
    background-color: #888888;
    color: #ffffff;
    border-radius: 20px;
}

#nameSelf {
    color: #5c6bc0;
    font-size: 11px;
    font-weight: bold;
}

#nameOther {
    color: #666666;
    font-size: 11px;
    font-weight: bold;
}

#bubbleSelf {
    background-color: #5c6bc0;
    color: #ffffff;
    border-radius: 16px 16px 4px 16px;
    font-size: 14px;
    border: none;
    selection-background-color: rgba(255,255,255,0.3);
    selection-color: #ffffff;
}

#bubbleOther {
    background-color: #ffffff;
    color: #333333;
    border-radius: 16px 16px 16px 4px;
    font-size: 14px;
    border: 1px solid #e8eaed;
    selection-background-color: #5c6bc0;
    selection-color: #ffffff;
}

#timeLabel {
    color: #aaaaaa;
    font-size: 10px;
}

#systemMessage {
    color: #999999;
    font-size: 12px;
    padding: 6px 16px;
    background-color: rgba(0,0,0,0.02);
    border-radius: 12px;
    margin: 4px 20px;
}

/* ---- Dialogs ---- */
QDialog {
    background-color: #ffffff;
}

#dialogContainer {
    background-color: #ffffff;
    border-radius: 20px;
}

#titleLabel {
    color: #333333;
    font-size: 28px;
}

#subtitleLabel {
    color: #999999;
    font-size: 13px;
}

QPushButton#primaryButton {
    background-color: #5c6bc0;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: bold;
    padding: 12px;
    letter-spacing: 4px;
}

QPushButton#primaryButton:hover {
    background-color: #4a5ab0;
}

QPushButton#primaryButton:pressed {
    background-color: #3a4aa0;
}

QPushButton#primaryButton:disabled {
    background-color: #cccccc;
}

QPushButton#linkButton {
    color: #5c6bc0;
    border: none;
    background: transparent;
    font-size: 13px;
    padding: 6px;
}

QPushButton#linkButton:hover {
    color: #3a4aa0;
    text-decoration: underline;
}

QLineEdit {
    background-color: #f2f3f5;
    border: 2px solid #e0e2e5;
    border-radius: 12px;
    padding: 10px 16px;
    font-size: 14px;
    color: #333333;
    selection-background-color: #5c6bc0;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border-color: #5c6bc0;
    background-color: #ffffff;
}

#statusLabel {
    font-size: 13px;
    min-height: 20px;
}

/* ---- Scroll Bars ---- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #c0c4cc;
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: #909399;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #c0c4cc;
    border-radius: 4px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background: #909399;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---- Menu Bar ---- */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e8eaed;
    padding: 2px;
    font-size: 13px;
}

QMenuBar::item {
    padding: 8px 16px;
    border-radius: 6px;
    color: #333333;
}

QMenuBar::item:hover {
    background-color: #eef0f5;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e8eaed;
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 10px 28px;
    border-radius: 6px;
    color: #333333;
}

QMenu::item:hover {
    background-color: #eef0f5;
}

QMenu::separator {
    height: 1px;
    background: #e8eaed;
    margin: 4px 12px;
}

/* ---- Status Bar ---- */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e8eaed;
    color: #999999;
    font-size: 12px;
    padding: 4px 12px;
}

QToolTip {
    background-color: #444444;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
}

QSplitter::handle {
    background-color: #e0e2e5;
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #5c6bc0;
}

/* ---- Server Page ---- */
#card {
    background-color: #ffffff;
    border: 1px solid #e8eaed;
    border-radius: 16px;
}

#cardTitle {
    color: #333333;
    font-size: 16px;
    font-weight: bold;
}

#serverLogList {
    background-color: #f8f8f8;
    border: 1px solid #e8eaed;
    border-radius: 10px;
    color: #555555;
    font-size: 13px;
    font-family: "Consolas", "Courier New", monospace;
}

/* ---- Radio Buttons ---- */
QRadioButton {
    color: #555555;
    font-size: 14px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid #c0c4cc;
    background-color: #ffffff;
}

QRadioButton::indicator:checked {
    border-color: #5c6bc0;
    background-color: #5c6bc0;
}

/* ---- Group Box ---- */
QGroupBox {
    color: #555555;
    font-size: 13px;
    font-weight: bold;
    border: 1px solid #e8eaed;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 18px;
}
