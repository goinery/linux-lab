* {
    font-family: "Huawei Sans", "Noto Sans CJK SC", "Noto Sans SC", "WenQuanYi Micro Hei", "WenQuanYi Zen Hei", "Source Han Sans CN", "Microsoft YaHei", "Segoe UI", "PingFang SC", sans-serif;
}

QWidget {
    font-size: 14px;
}

QMainWindow {
    background-color: #eef1f5;
}

#leftPanel {
    background-color: #2b2f3a;
    border-right: none;
}

#userListTitle {
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
    background-color: #2b2f3a;
    border-bottom: 1px solid #3a3f4b;
    padding: 12px;
    letter-spacing: 2px;
}

QListWidget#userList {
    background-color: #2b2f3a;
    border: none;
    outline: none;
    padding: 6px;
}

QListWidget#userList::item {
    padding: 12px 14px;
    border-radius: 10px;
    margin: 3px 4px;
    color: #b0b8c8;
    font-size: 14px;
}

QListWidget#userList::item:hover {
    background-color: #3a3f4b;
    color: #e0e4ec;
}

QListWidget#userList::item:selected {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                       stop:0 #4facfe, stop:1 #00f2fe);
    color: #ffffff;
    font-weight: bold;
}

#rightPanel {
    background-color: #eef1f5;
}

#chatTitleLabel {
    color: #2c3e50;
    font-size: 16px;
    font-weight: bold;
    background-color: #ffffff;
    border-bottom: 1px solid #e8ecf1;
    padding: 12px 20px;
}

#chatScrollArea {
    background-color: #eef1f5;
    border: none;
}

#messagesContainer {
    background-color: #eef1f5;
}

#inputArea {
    background-color: #ffffff;
    border-top: 1px solid #e8ecf1;
}

QTextEdit#inputEdit {
    background-color: #f7f8fa;
    border: 2px solid #e0e4ec;
    border-radius: 16px;
    padding: 10px 18px;
    font-size: 14px;
    color: #2c3e50;
    selection-background-color: #4facfe;
    selection-color: #ffffff;
}

QTextEdit#inputEdit:focus {
    border-color: #4facfe;
    background-color: #ffffff;
}

QPushButton#sendButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                       stop:0 #4facfe, stop:1 #00f2fe);
    color: #ffffff;
    border: none;
    border-radius: 14px;
    font-size: 15px;
    font-weight: bold;
    padding: 10px 20px;
    letter-spacing: 2px;
}

QPushButton#sendButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                       stop:0 #3d9aef, stop:1 #00dfee);
}

QPushButton#sendButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                       stop:0 #2d8adf, stop:1 #00c0de);
}

#avatarSelf {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                       stop:0 #4facfe, stop:1 #00f2fe);
    color: #ffffff;
    border-radius: 20px;
}

#avatarOther {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                       stop:0 #667eea, stop:1 #764ba2);
    color: #ffffff;
    border-radius: 20px;
}

#nameSelf {
    color: #4facfe;
    font-size: 11px;
    font-weight: bold;
}

#nameOther {
    color: #667eea;
    font-size: 11px;
    font-weight: bold;
}

#bubbleSelf {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                       stop:0 #4facfe, stop:1 #00c6fb);
    color: #ffffff;
    border-radius: 16px 16px 4px 16px;
    font-size: 14px;
    border: none;
    padding: 8px 14px;
    selection-background-color: rgba(255,255,255,0.4);
    selection-color: #ffffff;
}

#bubbleOther {
    background-color: #ffffff;
    color: #2c3e50;
    border-radius: 16px 16px 16px 4px;
    font-size: 14px;
    border: none;
    padding: 8px 14px;
    selection-background-color: #4facfe;
    selection-color: #ffffff;
}

#timeLabel {
    color: #a0aab4;
    font-size: 10px;
}

#systemMessage {
    color: #8e99a4;
    font-size: 12px;
    padding: 6px 16px;
    background-color: rgba(0,0,0,0.03);
    border-radius: 12px;
    margin: 4px 20px;
}

QDialog {
    background-color: #ffffff;
}

#dialogContainer {
    background-color: #ffffff;
    border-radius: 20px;
}

#titleLabel {
    color: #2c3e50;
    font-size: 28px;
}

#subtitleLabel {
    color: #8e99a4;
    font-size: 13px;
}

QPushButton#primaryButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                       stop:0 #4facfe, stop:1 #00f2fe);
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: bold;
    padding: 12px;
    letter-spacing: 4px;
}

QPushButton#primaryButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                       stop:0 #3d9aef, stop:1 #00dfee);
}

QPushButton#primaryButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                       stop:0 #2d8adf, stop:1 #00c0de);
}

QPushButton#primaryButton:disabled {
    background-color: #b0bec5;
}

QPushButton#linkButton {
    color: #4facfe;
    border: none;
    background: transparent;
    font-size: 13px;
    padding: 6px;
}

QPushButton#linkButton:hover {
    color: #2d8adf;
    text-decoration: underline;
}

QLineEdit {
    background-color: #f7f8fa;
    border: 2px solid #e0e4ec;
    border-radius: 12px;
    padding: 10px 16px;
    font-size: 14px;
    color: #2c3e50;
    selection-background-color: #4facfe;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border-color: #4facfe;
    background-color: #ffffff;
}

#statusLabel {
    font-size: 13px;
    min-height: 20px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #c8cdd4;
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: #a0a8b4;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #c8cdd4;
    border-radius: 4px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background: #a0a8b4;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e8ecf1;
    padding: 2px;
    font-size: 13px;
}

QMenuBar::item {
    padding: 8px 16px;
    border-radius: 6px;
    color: #2c3e50;
}

QMenuBar::item:hover {
    background-color: #e8f4fd;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e8ecf1;
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 10px 28px;
    border-radius: 6px;
    color: #2c3e50;
}

QMenu::item:hover {
    background-color: #e8f4fd;
}

QMenu::separator {
    height: 1px;
    background: #e8ecf1;
    margin: 4px 12px;
}

QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e8ecf1;
    color: #8e99a4;
    font-size: 12px;
    padding: 4px 12px;
}

QToolTip {
    background-color: #2c3e50;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
}

QSplitter::handle {
    background-color: #e0e4ec;
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #4facfe;
}
