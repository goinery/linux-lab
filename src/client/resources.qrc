<RCC>
    <qresource prefix="/">
        <file alias="style.qss">../../resources/style.qss</file>
        <file alias="theme_template.qss">../../resources/themes/template.qss</file>
    </qresource>
    <qresource prefix="/cursors">
        <file alias="cursor_arrow.png">../../resources/cursors/cursor_arrow.png</file>
        <file alias="cursor_hand.png">../../resources/cursors/cursor_hand.png</file>
        <file alias="cursor_size_hor.png">../../resources/cursors/cursor_size_hor.png</file>
        <file alias="cursor_size_ver.png">../../resources/cursors/cursor_size_ver.png</file>
        <file alias="cursor_size_fdiag.png">../../resources/cursors/cursor_size_fdiag.png</file>
        <file alias="cursor_size_bdiag.png">../../resources/cursors/cursor_size_bdiag.png</file>
        <file alias="cursor_move..png">../../resources/cursors/cursor_move..png</file>
        <file alias="cursor_ibeam.png">../../resources/cursors/cursor_ibeam.png</file>
    </qresource>
</RCC>
